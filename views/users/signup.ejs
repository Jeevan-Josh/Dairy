<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>SignUp on Wanderlust</title>
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />
    <style>
      :root {
        --bg: #0f172a;
        --panel: rgba(15, 23, 42, 0.92);
        --accent: #a855f7;
        --accent-2: #7c3aed;
        --text: #e2e8f0;
        --muted: #94a3b8;
        --shadow: 0 20px 60px rgba(15, 23, 42, 0.35);
      }
      * {
        box-sizing: border-box;
      }
      body {
        margin: 0;
        min-height: 100vh;
        font-family: 'Inter', system-ui, sans-serif;
        background: radial-gradient(circle at top left, rgba(168, 85, 247, 0.22), transparent 25%),
          radial-gradient(circle at bottom right, rgba(124, 58, 237, 0.24), transparent 25%),
          linear-gradient(135deg, #020617 0%, #111827 100%);
        display: flex;
        justify-content: center;
        align-items: center;
        color: var(--text);
        position: relative;
        overflow: hidden;
      }
      body::before,
      body::after {
        content: '';
        position: absolute;
        border-radius: 50%;
        filter: blur(100px);
        pointer-events: none;
        opacity: 0.5;
      }
      body::before {
        left: 14%;
        top: 10%;
        width: 520px;
        height: 520px;
        background: radial-gradient(circle, rgba(168, 85, 247, 0.18), transparent 55%);
        animation: drift-left 14s ease-in-out infinite alternate;
      }
      body::after {
        right: 12%;
        bottom: 8%;
        width: 380px;
        height: 380px;
        background: radial-gradient(circle, rgba(124, 58, 237, 0.16), transparent 55%);
        animation: drift-right 12s ease-in-out infinite alternate;
      }
      .signup-container {
        width: min(460px, calc(100% - 32px));
        padding: 40px;
        background: rgba(10, 15, 30, 0.96);
        border: 1px solid rgba(148, 163, 184, 0.14);
        border-radius: 34px;
        box-shadow: 0 28px 90px rgba(15, 23, 42, 0.36);
        backdrop-filter: blur(18px);
        animation: fadeIn 0.9s ease both;
        position: relative;
        overflow: hidden;
      }
      .signup-container::before {
        content: '';
        position: absolute;
        inset: 0;
        background: radial-gradient(circle at top right, rgba(168, 85, 247, 0.1), transparent 30%),
                    radial-gradient(circle at bottom left, rgba(124, 58, 237, 0.08), transparent 26%);
        pointer-events: none;
        opacity: 0.9;
      }
      h1 {
        color: #e2e8f0;
        background: linear-gradient(135deg, #7c3aed, #a855f7 45%, #8b5cf6 75%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        animation: textGlow 6s ease-in-out infinite;
      }
      .signup-container h1 {
        text-align: center;
        margin-bottom: 26px;
        font-size: clamp(2rem, 2.3vw, 2.5rem);
        letter-spacing: -0.03em;
      }
      .form-control {
        border-radius: 20px;
        border: 1px solid rgba(148, 163, 184, 0.18);
        padding: 16px 20px;
        background: rgba(15, 23, 42, 0.9);
        color: var(--text);
      }
      .form-control:focus {
        outline: none;
        border-color: rgba(168, 85, 247, 0.8);
        box-shadow: 0 0 0 4px rgba(168, 85, 247, 0.12);
        background: rgba(15, 23, 42, 0.98);
      }
      .btn-success {
        width: 100%;
        font-size: 16px;
        font-weight: 700;
        letter-spacing: 0.02em;
        border-radius: 22px;
        background: linear-gradient(135deg, var(--accent), var(--accent-2));
        border: none;
        transition: transform 200ms ease, box-shadow 200ms ease, filter 200ms ease;
      }
      .btn-success:hover {
        transform: translateY(-2px);
        filter: brightness(1.05);
        box-shadow: 0 18px 40px rgba(168, 85, 247, 0.25);
      }
      a {
        color: var(--accent);
        text-decoration: none;
        transition: color 150ms ease, transform 150ms ease;
      }
      a:hover {
        color: var(--accent-2);
        transform: translateY(-1px);
      }
      @keyframes fadeIn {
        from { opacity: 0; transform: translateY(24px); }
        to { opacity: 1; transform: translateY(0); }
      }
      @keyframes drift-left {
        from { transform: translateX(0px) translateY(0px) scale(1); }
        to { transform: translateX(20px) translateY(12px) scale(1.05); }
      }
      @keyframes drift-right {
        from { transform: translateX(0px) translateY(0px) scale(1); }
        to { transform: translateX(-18px) translateY(-14px) scale(1.05); }
      }
      @keyframes textGlow {
        0%, 100% { text-shadow: 0 10px 24px rgba(168, 85, 247, 0.16); }
        50% { text-shadow: 0 16px 40px rgba(124, 58, 237, 0.24); }
      }
    </style>
  </head>
  <body>
    <div class="signup-container">
      <h1>SignUp</h1>
      <form action="/signup" method="post" class="needs-validation" novalidate>
        <div class="mb-3">
          <label for="username" class="form-label"><b>Username</b></label>
          <input
            type="text"
            id="username"
            name="username"
            class="form-control"
            required
          />
        </div>
        <div class="mb-3">
          <label for="email" class="form-label"><b>Email</b></label>
          <input
            type="email"
            id="email"
            name="email"
            class="form-control"
            required
          />
        </div>
        <div class="mb-3">
          <label for="password" class="form-label"><b>Password</b></label>
          <input
            type="password"
            id="password"
            name="password"
            class="form-control"
            required
          />
        </div>
        <button class="btn btn-success">SignUp</button>
        <br>
        <br>
        <p>Already have an account? <a href="/login">Login</a></p>
      </form>
    </div>
  </body>
</html>