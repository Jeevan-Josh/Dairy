<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Edit Entry</title>
    <style>
        :root {
            --bg: #020617;
            --panel: rgba(15, 23, 42, 0.94);
            --accent: #a855f7;
            --accent-2: #7c3aed;
            --text: #e2e8f0;
            --muted: #94a3b8;
            --shadow: 0 32px 100px rgba(15, 23, 42, 0.42);
        }
        * {
            box-sizing: border-box;
        }
        body {
            margin: 0;
            min-height: 100vh;
            font-family: 'Inter', system-ui, sans-serif;
            background: radial-gradient(circle at top left, rgba(168, 85, 247, 0.18), transparent 20%),
                        radial-gradient(circle at bottom right, rgba(124, 58, 237, 0.16), transparent 20%),
                        linear-gradient(180deg, #020617 0%, #0d111b 100%);
            color: var(--text);
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 24px;
            position: relative;
            overflow: hidden;
        }
        body::before,
        body::after {
            content: '';
            position: absolute;
            border-radius: 50%;
            filter: blur(100px);
            pointer-events: none;
            opacity: 0.5;
        }
        body::before {
            width: 420px;
            height: 420px;
            top: 10%;
            left: 15%;
            background: radial-gradient(circle, rgba(168, 85, 247, 0.16), transparent 58%);
            animation: drift-left 14s ease-in-out infinite alternate;
        }
        body::after {
            width: 320px;
            height: 320px;
            right: 12%;
            bottom: 10%;
            background: radial-gradient(circle, rgba(124, 58, 237, 0.18), transparent 58%);
            animation: drift-right 12s ease-in-out infinite alternate;
        }
        .form-container {
            position: relative;
            z-index: 1;
            max-width: 760px;
            width: 100%;
            background: var(--panel);
            border: 1px solid rgba(255, 255, 255, 0.08);
            border-radius: 34px;
            padding: 36px;
            box-shadow: var(--shadow);
            backdrop-filter: blur(18px);
            animation: fadeInUp 0.9s ease both;
            overflow: hidden;
        }
        .form-container::before {
            content: '';
            position: absolute;
            inset: 0;
            background: radial-gradient(circle at 80% 20%, rgba(168, 85, 247, 0.08), transparent 32%),
                        radial-gradient(circle at 20% 80%, rgba(124, 58, 237, 0.08), transparent 28%);
            pointer-events: none;
            opacity: 0.9;
        }
        h1 {
            color: #e2e8f0;
            background: linear-gradient(135deg, #7c3aed, #a855f7 45%, #8b5cf6 75%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            animation: textGlow 6s ease-in-out infinite;
        }
        h1 {
            margin-top: 0;
            font-size: clamp(2.25rem, 3vw, 3rem);
            letter-spacing: -0.04em;
        }
        input[type="text"], textarea {
            width: 100%;
            border-radius: 20px;
            border: 1px solid rgba(148, 163, 184, 0.18);
            padding: 18px 22px;
            background: rgba(15, 23, 42, 0.94);
            color: var(--text);
            font-size: 1rem;
            margin: 16px 0;
            transition: border-color 180ms ease, box-shadow 180ms ease, transform 180ms ease;
        }
        input[type="text"]:focus,
        textarea:focus {
            outline: none;
            border-color: rgba(168, 85, 247, 0.8);
            box-shadow: 0 0 0 4px rgba(168, 85, 247, 0.12);
            transform: translateY(-1px);
        }
        textarea {
            min-height: 220px;
            resize: vertical;
        }
        button {
            border: none;
            border-radius: 999px;
            padding: 14px 28px;
            font-size: 1rem;
            font-weight: 700;
            background: linear-gradient(135deg, var(--accent), var(--accent-2));
            color: #070b1a;
            cursor: pointer;
            transition: transform 180ms ease, box-shadow 180ms ease, filter 180ms ease;
        }
        button:hover {
            transform: translateY(-2px);
            filter: brightness(1.05);
            box-shadow: 0 18px 40px rgba(168, 85, 247, 0.2);
        }
        a {
            display: inline-block;
            margin-top: 18px;
            color: var(--accent);
            transition: color 150ms ease, transform 150ms ease;
        }
        a:hover {
            color: var(--accent-2);
            transform: translateY(-1px);
        }
        @keyframes fadeInUp {
            from { opacity: 0; transform: translateY(18px); }
            to { opacity: 1; transform: translateY(0); }
        }
        @keyframes drift-left {
            from { transform: translateX(0px) translateY(0px) scale(1); }
            to { transform: translateX(20px) translateY(12px) scale(1.05); }
        }
        @keyframes drift-right {
            from { transform: translateX(0px) translateY(0px) scale(1); }
            to { transform: translateX(-18px) translateY(-14px) scale(1.05); }
        }
        @keyframes textGlow {
            0%, 100% { text-shadow: 0 10px 24px rgba(168, 85, 247, 0.16); }
            50% { text-shadow: 0 16px 40px rgba(124, 58, 237, 0.24); }
        }
    </style>
</head>
<body>
    <div class="form-container">
        <h1>Edit Entry</h1>
        <form action="/edit/<%= entry.id %>" method="POST">
            <input type="text" name="title" value="<%= entry.title %>" required />
            <textarea name="content" required><%= entry.content %></textarea>
            <button type="submit">Save</button>
        </form>
        <a href="/dashboard">Back to Dashboard</a>
    </div>
</body>
</html>
