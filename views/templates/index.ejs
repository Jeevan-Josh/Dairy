<!DOCTYPE html>
<html lang="en">
<head>
    <title>Daily Journal</title>
    <style>
        :root {
            --bg: #020617;
            --panel: rgba(15, 23, 42, 0.95);
            --panel-soft: rgba(15, 23, 42, 0.76);
            --border: rgba(148, 163, 184, 0.18);
            --accent: #a855f7;
            --accent-2: #7c3aed;
            --text: #e2e8f0;
            --muted: #94a3b8;
            --shadow: 0 24px 90px rgba(15, 23, 42, 0.35);
        }
        * {
            box-sizing: border-box;
        }
        html {
            scroll-behavior: smooth;
        }
        body {
            margin: 0;
            min-height: 100vh;
            font-family: 'Inter', system-ui, sans-serif;
            background: radial-gradient(circle at top left, rgba(168, 85, 247, 0.18), transparent 16%),
                        radial-gradient(circle at bottom right, rgba(124, 58, 237, 0.16), transparent 18%),
                        linear-gradient(180deg, #020617 0%, #090b14 65%, #0f172a 100%);
            color: var(--text);
            overflow-x: hidden;
            position: relative;
        }
        body::before,
        body::after {
            content: '';
            position: fixed;
            pointer-events: none;
            z-index: 0;
            border-radius: 50%;
            filter: blur(120px);
            opacity: 0.55;
        }
        body::before {
            left: 10%;
            top: 12%;
            width: 620px;
            height: 620px;
            background: radial-gradient(circle, rgba(168, 85, 247, 0.22), transparent 60%);
            animation: drift-left 16s ease-in-out infinite alternate;
        }
        body::after {
            right: 8%;
            bottom: 10%;
            width: 520px;
            height: 520px;
            background: radial-gradient(circle, rgba(124, 58, 237, 0.18), transparent 58%);
            animation: drift-right 14s ease-in-out infinite alternate;
        }
        .page-wrapper::before {
            content: '';
            position: absolute;
            inset: 0;
            background: radial-gradient(circle at 22% 18%, rgba(168, 85, 247, 0.08), transparent 14%),
                        radial-gradient(circle at 78% 15%, rgba(124, 58, 237, 0.07), transparent 11%);
            pointer-events: none;
            z-index: 0;
        }
        h1 {
            margin: 0;
            font-size: clamp(2.4rem, 3.8vw, 4rem);
            letter-spacing: -0.05em;
            background: linear-gradient(135deg, #7c3aed, #a855f7 45%, #c084fc 70%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            animation: textGlow 6s ease-in-out infinite;
        }
        .page-wrapper {
            width: min(1160px, calc(100% - 32px));
            margin: 40px auto;
            display: grid;
            gap: 24px;
            grid-template-columns: 1.2fr 0.8fr;
            align-items: start;
            position: relative;
            z-index: 1;
        }
        .hero-panel,
        .entry-panel {
            background: var(--panel);
            border: 1px solid var(--border);
            border-radius: 34px;
            box-shadow: var(--shadow);
            padding: 32px;
            backdrop-filter: blur(20px);
            animation: fadeInUp 0.9s ease both;
        }
        .hero-panel {
            animation-delay: 0.06s;
        }
        .entry-panel {
            animation-delay: 0.12s;
        }
        .hero-header {
            display: flex;
            flex-direction: column;
            gap: 20px;
            margin-bottom: 26px;
        }
        h1 {
            margin: 0;
            font-size: clamp(2.4rem, 3.8vw, 4rem);
            letter-spacing: -0.05em;
            text-shadow: 0 12px 30px rgba(168, 85, 247, 0.18);
        }
        .hero-subtitle {
            margin: 0;
            color: var(--muted);
            max-width: 700px;
            line-height: 1.75;
            font-size: 1.05rem;
        }
        .hero-actions {
            display: flex;
            flex-wrap: wrap;
            gap: 14px;
            align-items: center;
        }
        .badge {
            display: inline-flex;
            align-items: center;
            gap: 10px;
            background: rgba(168, 85, 247, 0.12);
            border: 1px solid rgba(168, 85, 247, 0.28);
            color: var(--text);
            padding: 0.95rem 1rem;
            border-radius: 999px;
            font-size: 0.95rem;
            animation: glowPulse 4s ease-in-out infinite;
        }
        .logout-link {
            color: var(--accent);
            text-decoration: none;
            font-weight: 600;
            transition: color 180ms ease, transform 180ms ease;
        }
        .logout-link:hover {
            color: var(--accent-2);
            transform: translateY(-1px);
        }
        .entry-card,
        .filter-card {
            background: rgba(255, 255, 255, 0.04);
            border: 1px solid rgba(255, 255, 255, 0.08);
            border-radius: 26px;
            padding: 26px;
            box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.03);
        }
        .entry-form {
            display: grid;
            gap: 18px;
        }
        .entry-form input,
        .entry-form textarea,
        .filter-form input {
            width: 100%;
            border-radius: 22px;
            border: 1px solid rgba(148, 163, 184, 0.16);
            padding: 18px 22px;
            background: rgba(15, 23, 42, 0.96);
            color: var(--text);
            font-size: 1rem;
            transition: border-color 180ms ease, transform 180ms ease, box-shadow 180ms ease;
        }
        .entry-form input:focus,
        .entry-form textarea:focus,
        .filter-form input:focus {
            outline: none;
            border-color: rgba(168, 85, 247, 0.7);
            box-shadow: 0 0 0 4px rgba(168, 85, 247, 0.12);
            transform: translateY(-1px);
        }
        .entry-form textarea {
            min-height: 180px;
            resize: vertical;
        }
        .entry-form button,
        .filter-form button {
            border: none;
            border-radius: 999px;
            padding: 16px 30px;
            font-weight: 700;
            background: linear-gradient(135deg, var(--accent), var(--accent-2));
            color: #070b1a;
            cursor: pointer;
            transition: transform 180ms ease, box-shadow 180ms ease, filter 180ms ease;
        }
        .entry-form button:hover,
        .filter-form button:hover {
            transform: translateY(-2px);
            filter: brightness(1.05);
            box-shadow: 0 22px 50px rgba(168, 85, 247, 0.22);
        }
        .entry-panel-header {
            display: flex;
            flex-wrap: wrap;
            justify-content: space-between;
            gap: 20px;
            align-items: center;
            margin-bottom: 20px;
        }
        .entry-panel-header h2 {
            margin: 0;
            font-size: clamp(1.8rem, 2vw, 2.3rem);
        }
        .filter-form {
            display: flex;
            flex-wrap: wrap;
            gap: 12px;
            align-items: center;
        }
        .filter-form label {
            margin: 0;
            color: var(--muted);
        }
        .filter-form a {
            color: var(--accent);
            text-decoration: none;
            font-weight: 600;
            transition: color 150ms ease;
        }
        .filter-form a:hover {
            color: var(--accent-2);
        }
        .entry {
            position: relative;
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid rgba(255, 255, 255, 0.08);
            border-radius: 26px;
            padding: 24px;
            margin-bottom: 20px;
            backdrop-filter: blur(18px);
            box-shadow: 0 30px 70px rgba(0, 0, 0, 0.18);
            overflow: hidden;
            transition: transform 180ms ease, border-color 180ms ease, box-shadow 180ms ease;
            animation: popIn 0.6s ease both;
        }
        .entry:hover {
            transform: translateY(-3px);
            border-color: rgba(168, 85, 247, 0.35);
            box-shadow: 0 30px 80px rgba(168, 85, 247, 0.12);
        }
        .entry h3 {
            margin: 0 0 14px;
            font-size: 1.45rem;
            color: #f8fafc;
        }
        .entry p {
            margin: 0 0 18px;
            line-height: 1.85;
            color: #cbd5e1;
            white-space: pre-wrap;
        }
        .entry small {
            display: block;
            color: var(--muted);
            margin-bottom: 16px;
        }
        .entry-actions {
            display: flex;
            gap: 12px;
            flex-wrap: wrap;
        }
        .entry-actions button,
        .entry-actions a {
            border-radius: 999px;
            padding: 12px 18px;
            font-size: 0.95rem;
            text-decoration: none;
            cursor: pointer;
            border: 1px solid rgba(255, 255, 255, 0.08);
            background: rgba(255, 255, 255, 0.05);
            color: var(--text);
            transition: background 180ms ease, transform 180ms ease, border-color 180ms ease;
        }
        .entry-actions button:hover,
        .entry-actions a:hover {
            background: rgba(168, 85, 247, 0.16);
            transform: translateY(-1px);
            border-color: rgba(168, 85, 247, 0.28);
        }
        .empty-state {
            margin-top: 26px;
            padding: 28px;
            border-radius: 26px;
            border: 1px dashed rgba(148, 163, 184, 0.32);
            color: var(--muted);
            text-align: center;
            background: rgba(255,255,255,0.03);
        }
        @keyframes fadeInUp {
            from {
                opacity: 0;
                transform: translateY(28px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }
        @keyframes popIn {
            from { opacity: 0; transform: translateY(18px) scale(0.98); }
            to { opacity: 1; transform: translateY(0) scale(1); }
        }
        @keyframes glowPulse {
            0%, 100% { box-shadow: 0 0 0 0 rgba(168, 85, 247, 0.18); }
            50% { box-shadow: 0 0 40px rgba(168, 85, 247, 0.12); }
        }
        @keyframes drift-left {
            from { transform: translateX(0px) translateY(0px) scale(1); }
            to { transform: translateX(20px) translateY(12px) scale(1.05); }
        }
        @keyframes drift-right {
            from { transform: translateX(0px) translateY(0px) scale(1); }
            to { transform: translateX(-18px) translateY(-14px) scale(1.05); }
        }
        @keyframes textGlow {
            0%, 100% { text-shadow: 0 10px 24px rgba(168, 85, 247, 0.16); }
            50% { text-shadow: 0 16px 40px rgba(124, 58, 237, 0.24); }
        }
        @media (max-width: 960px) {
            .page-wrapper {
                grid-template-columns: 1fr;
            }
        }
        @media (max-width: 640px) {
            .entry-panel, .hero-panel {
                padding: 24px;
            }
            .entry-form button,
            .filter-form button {
                width: 100%;
            }
        }
    </style>
</head>
<body>
    <div class="page-wrapper">
        <div class="hero-panel">
            <div class="hero-header">
                <h1>Daily Journal</h1>
                <p class="hero-subtitle">Capture your day with style. Your notes are private, organized, and easy to revisit.</p>
                <div class="hero-actions">
                    <span class="badge">Logged in as: <strong><%= userEmail %></strong></span>
                    <a class="logout-link" href="/logout">Logout</a>
                </div>
            </div>

            <div class="entry-card">
                <form action="/add" method="POST" class="entry-form">
                    <input type="text" name="title" placeholder="Title" required />
                    <textarea name="content" placeholder="Write your journal entry here..." required></textarea>
                    <button type="submit">Add Entry</button>
                </form>
            </div>
        </div>

        <div class="entry-panel">
            <div class="entry-panel-header">
                <h2>Entries</h2>
                <form action="/dashboard" method="GET" class="filter-form">
                    <label for="filterDate">Filter by Date:</label>
                    <input type="date" id="filterDate" name="filterDate" value="<%= filterDate || '' %>">
                    <button type="submit">Filter</button>
                    <a href="/dashboard">Clear</a>
                </form>
            </div>

            <% if (entries.length === 0) { %>
                <div class="empty-state">
                    <h3>No entries yet</h3>
                    <p>Start writing your first journal entry and watch your thoughts come alive.</p>
                </div>
            <% } else { %>
                <% entries.forEach(entry => { %>
                    <div class="entry">
                        <h3><%= entry.title %></h3>
                        <p><%= entry.content %></p>
                        <small><%= new Date(entry.date).toLocaleString() %></small>
                        <div class="entry-actions">
                            <form action="/delete/<%= entry.id %>" method="POST">
                                <button type="submit">Delete</button>
                            </form>
                            <a href="/edit/<%= entry.id %>">Edit</a>
                        </div>
                    </div>
                <% }) %>
            <% } %>
        </div>
    </div>
</body>
</html>